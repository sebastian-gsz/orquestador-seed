#!/bin/sh
# pre-commit — capa determinista del workboard
# Principio (tip 38 del corpus): lo consultivo vive en los contratos (~80%);
# lo que debe pasar SIEMPRE se mecaniza aquí (100%).
# Instalación: git config core.hooksPath docs/workboard/hooks
# Desinstalar: git config --unset core.hooksPath

set -u

ROOT=$(git rev-parse --show-toplevel)
HDIR=$(cd "$(dirname "$0")" && pwd)
WB=$(cd "$HDIR/.." && pwd)

# 1) Verificador del workboard — solo si el nodo está montado (tiene items/)
if [ -d "$WB/items" ] && command -v node >/dev/null 2>&1; then
  node "$WB/verify-workboard.mjs" "$WB" || exit 1
fi

# 2) Instancia viva de la semilla, si existe (solo en el repo-semilla)
if [ -d "$ROOT/_dev/workboard/items" ] && [ -f "$ROOT/fase-5-workboard/verify-workboard.mjs" ] && command -v node >/dev/null 2>&1; then
  node "$ROOT/fase-5-workboard/verify-workboard.mjs" "$ROOT/_dev/workboard" || exit 1
fi

# 3) Higiene: worktrees/ y .env jamás se commitean (§5.1, principio 10)
if git diff --cached --name-only | grep -qE '(^|/)worktrees/|(^|/)\.env$'; then
  echo "BLOQUEADO: el commit contiene worktrees/ o .env (contrato §5.1)" >&2
  exit 1
fi

# 4) Secretos obvios en el diff (best-effort; el grep exhaustivo es el criterio 11 de F7)
if git diff --cached -U0 | grep -qE 'sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  echo "BLOQUEADO: posible secreto en el diff (principio 10)" >&2
  exit 1
fi

# 5) Credenciales embebidas en la URL de algún remote (protocolo secretos §El almacén;
#    SEED-021 decisión 2: prohibición a toda costa, mecanizada al 100% de los destinos)
BADURLS=$(git remote -v | awk '{print $2}' | sort -u | grep -E '(^|[a-z])https?://[^/@[:space:]]+@' || true)
if [ -n "$BADURLS" ]; then
  echo "BLOQUEADO: remote con credenciales embebidas en la URL (prohibido a toda costa; usa el credential helper):" >&2
  echo "$BADURLS" | sed 's#://[^/@]*@#://***@#' >&2
  exit 1
fi

# 6) Dualidad workboard↔Jira (SEED-026): el modo lo declara MODO.md del workboard.
#    local → recordatorio de migración (el tablón es un andamio temporal);
#    jira  → bloquear ítems NUEVOS en items/ (las tareas se crean en Jira).
MODO_FILE=""
for d in "$WB" "$ROOT/_dev/workboard" "$ROOT/docs/workboard"; do
  if [ -f "$d/MODO.md" ]; then MODO_FILE="$d/MODO.md"; break; fi
done
MODO=$(sed -n '1,15s/^modo:[[:space:]]*//p' "$MODO_FILE" 2>/dev/null | head -n 1 | tr -d '"\r')
if [ "$MODO" = "jira" ]; then
  NUEVOS=$(git diff --cached --name-only --diff-filter=A | grep -E '(^|/)workboard/items/[^/]+\.md$' || true)
  if [ -n "$NUEVOS" ]; then
    JIRA=$(sed -n '1,15s/^jira:[[:space:]]*//p' "$MODO_FILE" | head -n 1 | tr -d '"\r')
    echo "BLOQUEADO: modo jira activo${JIRA:+ — destino: $JIRA} — las tareas se crean en Jira, no en el workboard local (SEED-026); el tablón es solo punto de reglas maestras." >&2
    echo "$NUEVOS" | sed 's/^/       nuevo ítem local: /' >&2
    exit 1
  fi
else
  echo "[workboard] modo local (temporal): las tareas migran a Jira — runbook migrar-tareas-a-jira.md (SEED-026)" >&2
fi

# 7) Coherencia ítem↔issue Jira (SEED-027): solo si MODO.md declara destino `jira:`.
#    Online con deriva → bloquea (la misma entrega aplica a las dos superficies, EVAL-5).
#    Modo degradado (sin credencial en el almacén o sin red) → avisa, no bloquea.
if command -v node >/dev/null 2>&1; then
  if [ -f "$WB/verify-jira.mjs" ]; then
    node "$WB/verify-jira.mjs" "$WB" || exit 1
  fi
  if [ -d "$ROOT/_dev/workboard" ] && [ -f "$ROOT/fase-5-workboard/verify-jira.mjs" ]; then
    node "$ROOT/fase-5-workboard/verify-jira.mjs" "$ROOT/_dev/workboard" || exit 1
  fi
fi

exit 0
